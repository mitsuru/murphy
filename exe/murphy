#!/usr/bin/env ruby
# frozen_string_literal: true

# `bundle exec murphy ...` entry point (C2; ADR 0048). Resolves the
# platform's precompiled native binary and `exec`s it so signals, stdio,
# and the exit code pass through unchanged (`bundle exec` semantics).

require_relative "../lib/murphy/native"

begin
  Murphy::Native.ensure_gem_path_env!
  binary = Murphy::Native.native_binary
  exec(binary, *ARGV)
rescue RuntimeError => e
  warn e.message
  exit 2
end
